# DL4MicEverywhere notebook runtime defaults for Python 3.7.
# Notebook requirements override a default simply by naming the same package.
# nbformat 5.0.x is older than any JupyterLab 3.x server accepts, and JupyterLab
# 3.6 needs requests>=2.28, which notebooks pinning older requests cannot use.
nbformat==5.7.3
ipywidgets==8.1.0
jupyterlab==3.5.3
matplotlib==3.5.3
# send2trash 2.0.0 excludes Python 3.7 only through "!=3.7.*", which uv ignores
# (it honours only lower bounds), so uv would pick it and pip would refuse it.
send2trash==1.8.3
# The converted notebooks import yaml to remember widget values
# (.tools/notebook_autoconversion/code_utils_one_cell.py).
pyyaml==6.0.1
# Keep the setuptools installed by the Dockerfiles (SETUPTOOLS_VERSION for
# Python 3.7); see python3.8plus.in.
setuptools==67.8.0
