# Keep scripts and configuration files in their native environments without
# requiring line-ending conversion during normal Windows launches.
*.sh text eol=lf
*.command text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.in text eol=lf
*.lock text eol=lf
*.lock.txt text eol=lf

# Deterministic human-edited dependency inputs.
requirements.txt text eol=lf
converter-requirements.txt text eol=lf
