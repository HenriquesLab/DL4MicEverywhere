# check=skip=InvalidDefaultArgInFrom
ARG CONVERTER_BASE_IMAGE
ARG FINAL_BASE_IMAGE
ARG UBUNTU_VERSION=22.04
ARG CUDA_VERSION=""
ARG CUDNN_VERSION=""

####
## Stage 1 - Download and convert the notebook
####
FROM ${CONVERTER_BASE_IMAGE} AS notebook_autoconversion

# PyPI downloads can briefly stall on Docker Desktop/WSL networks.
# Keep deterministic installs resilient without changing package resolution.
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10

WORKDIR /home

COPY docker/converter-requirements.lock.txt /tmp/converter-requirements.lock.txt
RUN python -m pip install --disable-pip-version-check --require-hashes \
        -r /tmp/converter-requirements.lock.txt && \
    rm /tmp/converter-requirements.lock.txt

# Read all the arguments
ARG CONVERTER_BASE_IMAGE
ARG FINAL_BASE_IMAGE
ARG PATH_TO_NOTEBOOK
ARG PATH_TO_REQUIREMENTS
ARG PATH_TO_REQUIREMENTS_LOCK
ARG SECTIONS_TO_REMOVE
ARG NOTEBOOK_NAME
ARG GPU_FLAG
ARG PYTHON_VERSION
ARG UBUNTU_VERSION
ARG CUDA_VERSION
ARG CUDNN_VERSION

# Download the notebook
ADD ${PATH_TO_NOTEBOOK} ./${NOTEBOOK_NAME}

# Use the converter from the exact local DL4MicEverywhere build context.
# Docker fingerprints COPY inputs, so no self-referential Git commit pin is needed.
COPY .tools/notebook_autoconversion/ /home/DL4MicEverywhere/.tools/notebook_autoconversion/
COPY .tools/python_tools/create_docker_info.py /home/DL4MicEverywhere/.tools/python_tools/create_docker_info.py

COPY ${PATH_TO_REQUIREMENTS_LOCK} /tmp/notebook-requirements.lock.txt

# Autoconvert the notebook
RUN python DL4MicEverywhere/.tools/notebook_autoconversion/transform.py \
        -p . \
        -n "${NOTEBOOK_NAME}" \
        -s "${SECTIONS_TO_REMOVE}" && \
    mv "colabless_${NOTEBOOK_NAME}" "${NOTEBOOK_NAME}" && \
    python DL4MicEverywhere/.tools/python_tools/create_docker_info.py \
        "/home/docker_info.txt" \
        "${UBUNTU_VERSION}" \
        "${CUDA_VERSION}" \
        "${CUDNN_VERSION}" \
        "${PATH_TO_NOTEBOOK}" \
        "${PATH_TO_REQUIREMENTS}" \
        "${PATH_TO_REQUIREMENTS_LOCK}" \
        "$(sha256sum /tmp/notebook-requirements.lock.txt | awk '{print $1}')" \
        "${SECTIONS_TO_REMOVE}" \
        "${NOTEBOOK_NAME}" \
        "${GPU_FLAG}" \
        "${PYTHON_VERSION}" \
        "${CONVERTER_BASE_IMAGE}" \
        "${FINAL_BASE_IMAGE}"

####
## Stage 2 - Final image
## Supported Python versions in this file: 3.7, 3.8, 3.9, 3.10, 3.11, 3.12, 3.13
## Interface build args accepted by all Dockerfiles:
##   CONVERTER_BASE_IMAGE, FINAL_BASE_IMAGE, UBUNTU_VERSION, CUDA_VERSION, CUDNN_VERSION
## CUDA_VERSION and CUDNN_VERSION are accepted here for interface consistency.
####
FROM ${FINAL_BASE_IMAGE} AS final

# Ownership label used by scoped DL4MicEverywhere Docker cleanup.
LABEL org.dl4miceverywhere.managed="true"
ARG UBUNTU_VERSION
ARG CUDA_VERSION
ARG CUDNN_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Read all the arguments
ARG PATH_TO_NOTEBOOK=""
ARG PATH_TO_REQUIREMENTS=""
ARG PATH_TO_REQUIREMENTS_LOCK=""
ARG SECTIONS_TO_REMOVE=""
ARG NOTEBOOK_NAME=""
ARG GPU_FLAG=""
ARG PYTHON_VERSION=""

# Environment
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Europe/Lisbon
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1
# Allow large hashed wheels to survive short network stalls during Docker builds.
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10

# Node / Python environment
ENV NODE_VERSION=20.10.0
ENV NVM_DIR=/root/.nvm
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:/root/.nvm/versions/node/v${NODE_VERSION}/bin:${PATH}"

# Base OS packages
RUN ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        build-essential \
        software-properties-common \
        gnupg \
        dirmngr \
        pkg-config \
        tzdata \
        ffmpeg \
        libsm6 \
        libxext6 \
        libopenmpi-dev \
        libfreetype6-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Node.js with NVM
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/bab86d5de571015b63fd8fc30b47bbe072a1290e/install.sh | bash && \
    source "${NVM_DIR}/nvm.sh" && \
    nvm install "${NODE_VERSION}" && \
    nvm use "${NODE_VERSION}" && \
    nvm alias default "${NODE_VERSION}"

# Install Python
RUN set -eux; \
    add-apt-repository -y ppa:deadsnakes/ppa; \
    apt-get update; \
    case "${PYTHON_VERSION}" in \
        3.10) \
            apt-get install -y --no-install-recommends \
                python3.10 \
                python3.10-dev \
                python3.10-venv \
            ;; \
        3.7|3.8|3.9|3.11|3.12|3.13) \
            apt-get install -y --no-install-recommends \
                "python${PYTHON_VERSION}" \
                "python${PYTHON_VERSION}-dev" \
                "python${PYTHON_VERSION}-venv" \
            ;; \
        *) \
            echo "Unsupported PYTHON_VERSION=${PYTHON_VERSION}. Supported values in this Dockerfile: 3.7, 3.8, 3.9, 3.10, 3.11, 3.12, 3.13." >&2; \
            exit 1 \
            ;; \
    esac; \
    "python${PYTHON_VERSION}" -m venv "${VIRTUAL_ENV}"; \
    # BUILD_SETUPTOOLS_SPEC is the upper limit for setuptools in the isolated
    # environments in which pip compiles packages without wheels. Python 3.9+
    # uses pip 25.3, whose build constraints do not affect the installed
    # setuptools, so the limit can stay below 74 (setuptools 74 removed
    # distutils.msvccompiler, needed by numpy.distutils builds such as stardist
    # 0.8.3). Older pips apply the same file to the whole install, so their
    # limit must still admit the setuptools pinned here and in the lock.
    case "${PYTHON_VERSION}" in \
        3.7) \
            PIP_VERSION=24.0; SETUPTOOLS_VERSION=67.8.0; WHEEL_VERSION=0.41.3; BUILD_SETUPTOOLS_SPEC="<=67.8.0" ;; \
        3.8) \
            PIP_VERSION=24.3.1; SETUPTOOLS_VERSION=75.3.2; WHEEL_VERSION=0.45.1; BUILD_SETUPTOOLS_SPEC="<=75.3.2" ;; \
        3.9|3.10|3.11|3.12|3.13) \
            PIP_VERSION=25.3; SETUPTOOLS_VERSION=75.3.2; WHEEL_VERSION=0.45.1; BUILD_SETUPTOOLS_SPEC="<74" ;; \
    esac; \
    "${VIRTUAL_ENV}/bin/python" -m pip install \
        "pip==${PIP_VERSION}" \
        "setuptools==${SETUPTOOLS_VERSION}" \
        "wheel==${WHEEL_VERSION}"; \
    ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python; \
    ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python3; \
    ln -sf "${VIRTUAL_ENV}/bin/pip" /usr/local/bin/pip; \
    ln -sf "${VIRTUAL_ENV}/bin/pip" /usr/local/bin/pip3; \
    # Without an upper limit each source build fetches the newest setuptools
    # (mpi4py 3.1.5 fails with 80+). A limit, unlike an exact pin, still lets a
    # package ask for an older setuptools (scikit-image 0.18 needs <=51).
    printf 'setuptools%s\n' "${BUILD_SETUPTOOLS_SPEC}" > /opt/dl4me-build-constraints.txt; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /home

# Install the complete, pre-resolved notebook environment.
# The lock includes transitive dependencies, hashes, and DL4MicEverywhere's
# runtime defaults for packages not explicitly supplied by the notebook input.
COPY ${PATH_TO_REQUIREMENTS_LOCK} /tmp/requirements.lock.txt
# The setuptools limit reaches the isolated build environments of packages
# compiled from source through PIP_BUILD_CONSTRAINT (pip 25.3+), or through
# PIP_CONSTRAINT with older pips. pip 25.3+ refuses to run when both are set,
# so exactly one is chosen, based on what this pip supports.
# pip cannot resume an interrupted download, and PIP_RETRIES does not cover a
# download that stalls halfway, so the install is retried up to three times.
# Downloads are kept in a BuildKit cache mount, which is not part of the image,
# so a retry or a later build only fetches what is missing. The hashes in the
# lock are still checked for every file taken from the cache.
RUN --mount=type=cache,id=dl4me-pip,target=/root/.cache/pip \
    pip_install_help=$(python -m pip install --help) && \
    case "$pip_install_help" in \
        *--build-constraint*) constraint_var=PIP_BUILD_CONSTRAINT ;; \
        *) constraint_var=PIP_CONSTRAINT ;; \
    esac && \
    for attempt in 1 2 3; do \
        env -u PIP_NO_CACHE_DIR "${constraint_var}=/opt/dl4me-build-constraints.txt" \
            python -m pip install --cache-dir /root/.cache/pip \
                --require-hashes -r /tmp/requirements.lock.txt && break; \
        if [ "$attempt" -eq 3 ]; then exit 1; fi; \
        echo "Installing the Python packages failed (attempt $attempt of 3). Retrying in 20 seconds ..."; \
        sleep 20; \
    done && \
    rm /tmp/requirements.lock.txt

# Copy the converted notebook from stage 1
COPY --from=notebook_autoconversion /home/${NOTEBOOK_NAME} /home/docker_info.txt /home/

CMD ["bash"]
