ARG UBUNTU_VERSION=20.04
ARG CUDA_VERSION=""
ARG CUDNN_VERSION=""

####
## Stage 1 - Download and convert the notebook
####
FROM python:3.9.20-alpine3.19 AS notebook_autoconversion

WORKDIR /home

COPY docker/converter-requirements.lock.txt /tmp/converter-requirements.lock.txt
RUN python -m pip install --disable-pip-version-check --require-hashes \
        -r /tmp/converter-requirements.lock.txt && \
    rm /tmp/converter-requirements.lock.txt

# Read all the arguments
ARG PATH_TO_NOTEBOOK
ARG PATH_TO_REQUIREMENTS
ARG PATH_TO_REQUIREMENTS_LOCK
ARG SECTIONS_TO_REMOVE
ARG NOTEBOOK_NAME
ARG GPU_FLAG
ARG PYTHON_VERSION
ARG UBUNTU_VERSION
ARG CUDA_VERSION
ARG CUDNN_VERSION

# Download the notebook
ADD ${PATH_TO_NOTEBOOK} ./${NOTEBOOK_NAME}

# Use the converter from the exact local DL4MicEverywhere build context.
# Docker fingerprints COPY inputs, so no self-referential Git commit pin is needed.
COPY .tools/notebook_autoconversion/ /home/DL4MicEverywhere/.tools/notebook_autoconversion/
COPY .tools/python_tools/create_docker_info.py /home/DL4MicEverywhere/.tools/python_tools/create_docker_info.py

COPY ${PATH_TO_REQUIREMENTS_LOCK} /tmp/notebook-requirements.lock.txt

# Autoconvert the notebook
RUN python DL4MicEverywhere/.tools/notebook_autoconversion/transform.py \
        -p . \
        -n "${NOTEBOOK_NAME}" \
        -s "${SECTIONS_TO_REMOVE}" && \
    mv "colabless_${NOTEBOOK_NAME}" "${NOTEBOOK_NAME}" && \
    python DL4MicEverywhere/.tools/python_tools/create_docker_info.py \
        "/home/docker_info.txt" \
        "${UBUNTU_VERSION}" \
        "${CUDA_VERSION}" \
        "${CUDNN_VERSION}" \
        "${PATH_TO_NOTEBOOK}" \
        "${PATH_TO_REQUIREMENTS}" \
        "${PATH_TO_REQUIREMENTS_LOCK}" \
        "$(sha256sum /tmp/notebook-requirements.lock.txt | awk '{print $1}')" \
        "${SECTIONS_TO_REMOVE}" \
        "${NOTEBOOK_NAME}" \
        "${GPU_FLAG}" \
        "${PYTHON_VERSION}"

####
## Stage 2 - Final image
## Supported Python versions in this file: 3.5, 3.6
## Interface build args accepted by all Dockerfiles:
##   UBUNTU_VERSION, CUDA_VERSION, CUDNN_VERSION
## Legacy Python is built from source so it can be used on any Ubuntu base.
## CUDA_VERSION and CUDNN_VERSION are accepted here for interface consistency.
####
FROM ubuntu:${UBUNTU_VERSION} AS final
ARG UBUNTU_VERSION
ARG CUDA_VERSION
ARG CUDNN_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Read all the arguments
ARG PATH_TO_NOTEBOOK=""
ARG PATH_TO_REQUIREMENTS=""
ARG PATH_TO_REQUIREMENTS_LOCK=""
ARG SECTIONS_TO_REMOVE=""
ARG NOTEBOOK_NAME=""
ARG GPU_FLAG=""
ARG PYTHON_VERSION=""

# Environment
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Europe/Lisbon
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

# Legacy-safe Node version
ENV NODE_VERSION=16.20.2
ENV NVM_DIR=/root/.nvm
ENV VIRTUAL_ENV=/opt/venv
ENV OPENSSL_PREFIX=/opt/openssl
ENV PATH="${VIRTUAL_ENV}/bin:/root/.nvm/versions/node/v${NODE_VERSION}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OPENSSL_PREFIX}/lib:${LD_LIBRARY_PATH}"

# Point EOL Ubuntu releases to old-releases when needed
RUN case "${UBUNTU_VERSION}" in \
        16.04|18.04) \
            sed -i -E 's|http://(archive|security).ubuntu.com/ubuntu/?|http://old-releases.ubuntu.com/ubuntu/|g' /etc/apt/sources.list ;; \
        *) \
            true ;; \
    esac

# Base OS packages and Python build dependencies
RUN ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        build-essential \
        software-properties-common \
        pkg-config \
        tzdata \
        ffmpeg \
        libsm6 \
        libxext6 \
        libopenmpi-dev \
        libfreetype6-dev \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libffi-dev \
        liblzma-dev \
        libncurses5-dev \
        libncursesw5-dev \
        libgdbm-dev \
        libnss3-dev \
        tk-dev \
        uuid-dev \
        xz-utils \
        perl \
        make && \
    rm -rf /var/lib/apt/lists/*

# Install Node.js with NVM
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/bab86d5de571015b63fd8fc30b47bbe072a1290e/install.sh | bash && \
    source "${NVM_DIR}/nvm.sh" && \
    nvm install "${NODE_VERSION}" && \
    nvm use "${NODE_VERSION}" && \
    nvm alias default "${NODE_VERSION}"

# Build OpenSSL 1.1 for legacy Python compatibility
RUN set -eux; \
    OPENSSL_VERSION=1.1.1w; \
    mkdir -p /tmp/build-openssl; \
    cd /tmp/build-openssl; \
    curl -fsSLO "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz"; \
    tar -xzf "openssl-${OPENSSL_VERSION}.tar.gz"; \
    cd "openssl-${OPENSSL_VERSION}"; \
    ./config --prefix="${OPENSSL_PREFIX}" --openssldir="${OPENSSL_PREFIX}" shared zlib; \
    make -j"$(nproc)"; \
    make install_sw; \
    rm -rf /tmp/build-openssl

# Build legacy Python from source so 3.5 / 3.6 can run on any Ubuntu base
RUN set -eux; \
    case "${PYTHON_VERSION}" in \
        3.5) \
            PYTHON_FULL_VERSION=3.5.10; \
            PIP_VERSION=20.3.4; \
            SETUPTOOLS_VERSION=49.6.0; \
            WHEEL_VERSION=0.37.1 \
            ;; \
        3.6) \
            PYTHON_FULL_VERSION=3.6.15; \
            PIP_VERSION=21.3.1; \
            SETUPTOOLS_VERSION=59.6.0; \
            WHEEL_VERSION=0.37.1 \
            ;; \
        *) \
            echo "Unsupported PYTHON_VERSION=${PYTHON_VERSION}. Supported values in this Dockerfile: 3.5, 3.6." >&2; \
            exit 1 \
            ;; \
    esac; \
    mkdir -p /tmp/build-python; \
    cd /tmp/build-python; \
    curl -fsSLO "https://www.python.org/ftp/python/${PYTHON_FULL_VERSION}/Python-${PYTHON_FULL_VERSION}.tgz"; \
    tar -xzf "Python-${PYTHON_FULL_VERSION}.tgz"; \
    cd "Python-${PYTHON_FULL_VERSION}"; \
    ./configure \
        --prefix="/opt/python/${PYTHON_VERSION}" \
        --with-ensurepip=install \
        --with-openssl="${OPENSSL_PREFIX}" \
        CPPFLAGS="-I${OPENSSL_PREFIX}/include" \
        LDFLAGS="-Wl,-rpath,${OPENSSL_PREFIX}/lib -L${OPENSSL_PREFIX}/lib"; \
    make -j"$(nproc)"; \
    make altinstall; \
    "/opt/python/${PYTHON_VERSION}/bin/python${PYTHON_VERSION}" -m venv "${VIRTUAL_ENV}"; \
    "${VIRTUAL_ENV}/bin/python" -m pip install \
        "pip==${PIP_VERSION}" \
        "setuptools==${SETUPTOOLS_VERSION}" \
        "wheel==${WHEEL_VERSION}"; \
    ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python; \
    ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python3; \
    ln -sf "${VIRTUAL_ENV}/bin/pip" /usr/local/bin/pip; \
    ln -sf "${VIRTUAL_ENV}/bin/pip" /usr/local/bin/pip3; \
    rm -rf /tmp/build-python

WORKDIR /home

# Install the complete, pre-resolved notebook environment.
# The lock includes transitive dependencies, hashes, and DL4MicEverywhere's
# runtime defaults for packages not explicitly supplied by the notebook input.
COPY ${PATH_TO_REQUIREMENTS_LOCK} /tmp/requirements.lock.txt
RUN python -m pip install --require-hashes -r /tmp/requirements.lock.txt && \
    rm /tmp/requirements.lock.txt

# Copy the converted notebook from stage 1
COPY --from=notebook_autoconversion /home/${NOTEBOOK_NAME} /home/docker_info.txt /home/

CMD ["bash"]
