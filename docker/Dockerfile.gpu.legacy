# check=skip=InvalidDefaultArgInFrom
ARG CONVERTER_BASE_IMAGE
ARG FINAL_BASE_IMAGE
ARG UBUNTU_VERSION=20.04
ARG CUDA_VERSION=11.2.2
ARG CUDNN_VERSION=8.1.1.33

####
## Stage 1 - Download and convert the notebook
####
FROM ${CONVERTER_BASE_IMAGE} AS notebook_autoconversion

# PyPI downloads can briefly stall on Docker Desktop/WSL networks.
# Keep deterministic installs resilient without changing package resolution.
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10

WORKDIR /home

COPY docker/converter-requirements.lock.txt /tmp/converter-requirements.lock.txt
RUN python -m pip install --disable-pip-version-check --require-hashes \
        -r /tmp/converter-requirements.lock.txt && \
    rm /tmp/converter-requirements.lock.txt

# Read all the arguments
ARG CONVERTER_BASE_IMAGE
ARG FINAL_BASE_IMAGE
ARG PATH_TO_NOTEBOOK
ARG PATH_TO_REQUIREMENTS
ARG PATH_TO_REQUIREMENTS_LOCK
ARG SECTIONS_TO_REMOVE
ARG NOTEBOOK_NAME
ARG GPU_FLAG
ARG PYTHON_VERSION
ARG UBUNTU_VERSION
ARG CUDA_VERSION
ARG CUDNN_VERSION

# Download the notebook
ADD ${PATH_TO_NOTEBOOK} ./${NOTEBOOK_NAME}

# Use the converter from the exact local DL4MicEverywhere build context.
# Docker fingerprints COPY inputs, so no self-referential Git commit pin is needed.
COPY .tools/notebook_autoconversion/ /home/DL4MicEverywhere/.tools/notebook_autoconversion/
COPY .tools/python_tools/create_docker_info.py /home/DL4MicEverywhere/.tools/python_tools/create_docker_info.py

COPY ${PATH_TO_REQUIREMENTS_LOCK} /tmp/notebook-requirements.lock.txt

# Autoconvert the notebook
RUN python DL4MicEverywhere/.tools/notebook_autoconversion/transform.py \
        -p . \
        -n "${NOTEBOOK_NAME}" \
        -s "${SECTIONS_TO_REMOVE}" && \
    mv "colabless_${NOTEBOOK_NAME}" "${NOTEBOOK_NAME}" && \
    python DL4MicEverywhere/.tools/python_tools/create_docker_info.py \
        "/home/docker_info.txt" \
        "${UBUNTU_VERSION}" \
        "${CUDA_VERSION}" \
        "${CUDNN_VERSION}" \
        "${PATH_TO_NOTEBOOK}" \
        "${PATH_TO_REQUIREMENTS}" \
        "${PATH_TO_REQUIREMENTS_LOCK}" \
        "$(sha256sum /tmp/notebook-requirements.lock.txt | awk '{print $1}')" \
        "${SECTIONS_TO_REMOVE}" \
        "${NOTEBOOK_NAME}" \
        "${GPU_FLAG}" \
        "${PYTHON_VERSION}" \
        "${CONVERTER_BASE_IMAGE}" \
        "${FINAL_BASE_IMAGE}"

####
## Stage 2 - Final legacy GPU image
## Supported Python versions in this file: 3.5, 3.6
## Interface build args accepted by all Dockerfiles:
##   CONVERTER_BASE_IMAGE, FINAL_BASE_IMAGE, UBUNTU_VERSION, CUDA_VERSION, CUDNN_VERSION
## Legacy Python is built from source so it can be used on any Ubuntu CUDA base.
## GPU support now follows the same arg contract as the modern GPU Dockerfile.
####
FROM ${FINAL_BASE_IMAGE} AS final

# Ownership label used by scoped DL4MicEverywhere Docker cleanup.
LABEL org.dl4miceverywhere.managed="true"
ARG UBUNTU_VERSION
ARG CUDA_VERSION
ARG CUDNN_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Read all the arguments
ARG PATH_TO_NOTEBOOK=""
ARG PATH_TO_REQUIREMENTS=""
ARG PATH_TO_REQUIREMENTS_LOCK=""
ARG SECTIONS_TO_REMOVE=""
ARG NOTEBOOK_NAME=""
ARG GPU_FLAG=""
ARG PYTHON_VERSION=""

# Environment
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Europe/Lisbon
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1
# Allow large hashed wheels to survive short network stalls during Docker builds.
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10

# GPU environment
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_HOME=/usr/local/cuda
ENV OPENSSL_PREFIX=/opt/openssl
ENV LD_LIBRARY_PATH="/usr/local/cuda/extras/CUPTI/lib64:/usr/local/cuda/lib64:${OPENSSL_PREFIX}/lib:${LD_LIBRARY_PATH}"
ENV XLA_FLAGS=--xla_gpu_cuda_data_dir=/usr/local/cuda

# Legacy-safe Node version
ENV NODE_VERSION=16.20.2
ENV NVM_DIR=/root/.nvm
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:/root/.nvm/versions/node/v${NODE_VERSION}/bin:/usr/local/cuda/bin:${PATH}"

# Point EOL Ubuntu releases to old-releases when needed
RUN case "${UBUNTU_VERSION}" in \
        16.04|18.04) \
            sed -i -E 's|http://(archive|security).ubuntu.com/ubuntu/?|http://old-releases.ubuntu.com/ubuntu/|g' /etc/apt/sources.list ;; \
        *) \
            true ;; \
    esac

# Base OS packages and Python build dependencies
RUN ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        build-essential \
        software-properties-common \
        gnupg \
        dirmngr \
        pkg-config \
        tzdata \
        ffmpeg \
        libsm6 \
        libxext6 \
        libopenmpi-dev \
        libfreetype6-dev \
        libgomp1 \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libffi-dev \
        liblzma-dev \
        libncurses5-dev \
        libncursesw5-dev \
        libgdbm-dev \
        libnss3-dev \
        tk-dev \
        uuid-dev \
        xz-utils \
        perl \
        make && \
    rm -rf /var/lib/apt/lists/*

# Install Node.js with NVM
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/bab86d5de571015b63fd8fc30b47bbe072a1290e/install.sh | bash && \
    source "${NVM_DIR}/nvm.sh" && \
    nvm install "${NODE_VERSION}" && \
    nvm use "${NODE_VERSION}" && \
    nvm alias default "${NODE_VERSION}"

# cuDNN install, pinned to the cudnn_version from configuration.yaml.
# The nvidia/cuda base image already provides the CUDA apt repository.
# Do not add it again, or apt may fail with conflicting Signed-By settings.
# NVIDIA's package names changed with cuDNN 9:
#   cuDNN <= 8: libcudnn8=<cudnn>-1+cuda<major.minor>
#   cuDNN >= 9: libcudnn9-cuda-<major>=<cudnn>-1
RUN set -eux; \
    if [ -z "${CUDNN_VERSION}" ]; then \
        echo "cudnn_version is empty in configuration.yaml; GPU images need an exact cuDNN version." >&2; \
        exit 1; \
    fi; \
    cudnn_major="${CUDNN_VERSION%%.*}"; \
    cuda_major="${CUDA_VERSION%%.*}"; \
    cuda_major_minor="${CUDA_VERSION%.*}"; \
    if [ "${cudnn_major}" -ge 9 ]; then \
        cudnn_packages="libcudnn${cudnn_major}-cuda-${cuda_major}=${CUDNN_VERSION}-1 libcudnn${cudnn_major}-dev-cuda-${cuda_major}=${CUDNN_VERSION}-1"; \
    else \
        cudnn_packages="libcudnn${cudnn_major}=${CUDNN_VERSION}-1+cuda${cuda_major_minor} libcudnn${cudnn_major}-dev=${CUDNN_VERSION}-1+cuda${cuda_major_minor}"; \
    fi; \
    apt-get update; \
    if ! apt-get install -y --no-install-recommends ${cudnn_packages}; then \
        echo "cuDNN ${CUDNN_VERSION} is not published for CUDA ${CUDA_VERSION} on Ubuntu ${UBUNTU_VERSION}. Check cuda_version and cudnn_version in configuration.yaml." >&2; \
        exit 1; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Build OpenSSL 1.1 for legacy Python compatibility
RUN set -eux; \
    OPENSSL_VERSION=1.1.1w; \
    mkdir -p /tmp/build-openssl; \
    cd /tmp/build-openssl; \
    curl -fsSLO "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz"; \
    tar -xzf "openssl-${OPENSSL_VERSION}.tar.gz"; \
    cd "openssl-${OPENSSL_VERSION}"; \
    ./config --prefix="${OPENSSL_PREFIX}" --openssldir="${OPENSSL_PREFIX}" shared zlib; \
    make -j"$(nproc)"; \
    make install_sw; \
    rm -rf /tmp/build-openssl

# Build legacy Python from source so 3.5 / 3.6 can run on any Ubuntu CUDA base
RUN set -eux; \
    case "${PYTHON_VERSION}" in \
        3.5) \
            PYTHON_FULL_VERSION=3.5.10; \
            PIP_VERSION=20.3.4; \
            SETUPTOOLS_VERSION=49.6.0; \
            WHEEL_VERSION=0.37.1 \
            ;; \
        3.6) \
            PYTHON_FULL_VERSION=3.6.15; \
            PIP_VERSION=21.3.1; \
            SETUPTOOLS_VERSION=59.6.0; \
            WHEEL_VERSION=0.37.1 \
            ;; \
        *) \
            echo "Unsupported PYTHON_VERSION=${PYTHON_VERSION}. Supported values in this Dockerfile: 3.5, 3.6." >&2; \
            exit 1 \
            ;; \
    esac; \
    mkdir -p /tmp/build-python; \
    cd /tmp/build-python; \
    curl -fsSLO "https://www.python.org/ftp/python/${PYTHON_FULL_VERSION}/Python-${PYTHON_FULL_VERSION}.tgz"; \
    tar -xzf "Python-${PYTHON_FULL_VERSION}.tgz"; \
    cd "Python-${PYTHON_FULL_VERSION}"; \
    ./configure \
        --prefix="/opt/python/${PYTHON_VERSION}" \
        --with-ensurepip=install \
        --with-openssl="${OPENSSL_PREFIX}" \
        CPPFLAGS="-I${OPENSSL_PREFIX}/include" \
        LDFLAGS="-Wl,-rpath,${OPENSSL_PREFIX}/lib -L${OPENSSL_PREFIX}/lib"; \
    make -j"$(nproc)"; \
    make altinstall; \
    "/opt/python/${PYTHON_VERSION}/bin/python${PYTHON_VERSION}" -m venv "${VIRTUAL_ENV}"; \
    # The pip bundled with Python 3.6.15 (18.1) crashes on PIP_NO_CACHE_DIR=1.
    env -u PIP_NO_CACHE_DIR "${VIRTUAL_ENV}/bin/python" -m pip install --no-cache-dir \
        "pip==${PIP_VERSION}" \
        "setuptools==${SETUPTOOLS_VERSION}" \
        "wheel==${WHEEL_VERSION}"; \
    ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python; \
    ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python3; \
    ln -sf "${VIRTUAL_ENV}/bin/pip" /usr/local/bin/pip; \
    ln -sf "${VIRTUAL_ENV}/bin/pip" /usr/local/bin/pip3; \
    # Same setuptools for the isolated environments in which pip compiles
    # packages without wheels; otherwise each build fetches the newest one.
    printf 'setuptools==%s\n' "${SETUPTOOLS_VERSION}" > /opt/dl4me-build-constraints.txt; \
    rm -rf /tmp/build-python

WORKDIR /home

# Install the complete, pre-resolved notebook environment.
# The lock includes transitive dependencies, hashes, and DL4MicEverywhere's
# runtime defaults for packages not explicitly supplied by the notebook input.
COPY ${PATH_TO_REQUIREMENTS_LOCK} /tmp/requirements.lock.txt
# PIP_CONSTRAINT also reaches the isolated build environments of packages
# compiled from source, so their setuptools stays pinned too.
RUN PIP_CONSTRAINT=/opt/dl4me-build-constraints.txt \
    python -m pip install --require-hashes -r /tmp/requirements.lock.txt && \
    rm /tmp/requirements.lock.txt

# Copy the converted notebook from stage 1
COPY --from=notebook_autoconversion /home/${NOTEBOOK_NAME} /home/docker_info.txt /home/

CMD ["bash"]
